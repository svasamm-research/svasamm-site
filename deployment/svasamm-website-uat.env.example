# Svasamm Website — UAT deployment environment (uat.svasamm.com)
# ==============================================================
# Set these in the Dokploy UAT app's Environment tab (or render the compose locally:
#   docker compose --env-file <file> -f deployment/docker-compose.uat.yml config
# ). NEVER commit the real filled-in file — it contains infrastructure details.
# ---------------------------------------------------------------------------

CUSTOM_IMAGE=svasamm/svasamm-website
CUSTOM_TAG=uat-latest
PULL_POLICY=always

# Agent VPS private IP — Hostinger console -> your UAT server -> Network tab (private IP)
AGENT_PRIVATE_IP=CHANGE_ME

# Host port to publish this app on (must be UNIQUE per app on the same server), e.g. 3001
BENCH_PORT=CHANGE_ME
