# Svasamm Website — Production deployment environment (svasamm.com)
# =================================================================
# Set these in the Dokploy PROD app's Environment tab (or render the compose locally:
#   docker compose --env-file <file> -f deployment/docker-compose.yml config
# ). NEVER commit the real filled-in file — it contains infrastructure details.
# ---------------------------------------------------------------------------

CUSTOM_IMAGE=svasamm/svasamm-website
CUSTOM_TAG=latest
PULL_POLICY=always

# Agent VPS private IP — Hostinger console -> your PROD server -> Network tab (private IP)
AGENT_PRIVATE_IP=CHANGE_ME

# Host port to publish this app on (must be UNIQUE per app on the same server), e.g. 3000
BENCH_PORT=CHANGE_ME
